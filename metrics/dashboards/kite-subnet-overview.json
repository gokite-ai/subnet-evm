    {
      "title": "Gas Used / Sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(subnet_evm_chain_gas_used_total[1m])",
          "legendFormat": "Gas Used /s",
          "refId": "A"
        }
      ]
